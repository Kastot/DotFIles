#waybar {

  
    background-color: rgba(45, 45, 46, 0.9  );
    margin: 10px; 
    color: #1e2a47; 
    margin-top: 6px;
    border-radius: 9px;
    
    padding-top: 6px;
}


#clock,
#pulseaudio,
#custom-logout,
#mpris {
    background: rgba(45, 45, 46, 0.6);
    margin: 0 4px;
    padding: 4px 10px;
    transition: background 0.2s ease;
    border: 2px solid #120996; /* Darker blue border */
    border-radius: 10px;
    color: #efeeff; /* Text color matches the border */
    
}

#clock:hover,
#pulseaudio:hover,
#custom-logout:hover,
#mpris:hover {
    background: #383838;
    color: #efeeff;
}

/* Clock specific */
#clock {
    font-weight: bold;
}

/* MPRIS music player */
#mpris {
    color: #efeeff;
}

/* PulseAudio volume */
#pulseaudio {
    color: #efeeff;
}

/* Custom logout button */
#custom-logout {
    color: #f38ba8;
    font-weight: bold;
}

/* Tooltips */
tooltip {
    background: #2e3440;
    color: #d8dee9;
    border-radius: 6px;
    padding: 5px;
}

